# 前端在本机 vite build 完成后，云主机只拷静态文件 + 访问门禁
ARG NGINX_IMAGE=nginxinc/nginx-unprivileged:1.27-alpine
FROM ${NGINX_IMAGE} AS runtime
USER root
RUN rm -rf /usr/share/nginx/html/* \
    && mkdir -p /etc/nginx/auth \
    && chown -R 101:101 /etc/nginx/auth
COPY --chown=101:101 client/dist/ /usr/share/nginx/html/
COPY --chown=101:101 infra/nginx/ai-novel-cloud.conf /etc/nginx/conf.d/default.conf
USER 101
EXPOSE 8080
