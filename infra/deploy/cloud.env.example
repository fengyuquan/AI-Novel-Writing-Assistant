NODE_ENV=production
HOST=0.0.0.0
PORT=3000
ALLOW_LAN=false

# 改成你的公网访问地址，多个用逗号分隔。例如：
# CORS_ORIGIN=http://1.2.3.4,https://novel.example.com
CORS_ORIGIN=http://127.0.0.1

AI_NOVEL_DATABASE_MODE=sqlite
DATABASE_URL=file:/app/server/data/dev.db
API_JSON_LIMIT=5mb
NOVEL_SNAPSHOT_RETENTION_COUNT=5

# 4G 机器建议先关 RAG；以后再单独开 Qdrant
RAG_ENABLED=false

# 首次用你迁上去的旧库时，如果 schema 推送提示会丢非关键表/列，可临时改为 true
PRISMA_PUSH_ON_START=true
PRISMA_ACCEPT_DATA_LOSS=false

# 模型 Key 可留空，上线后在网页「系统设置」里配置
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
