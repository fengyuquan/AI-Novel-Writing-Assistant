# 本机云更新脚本默认配置（复制为 cloud-update.local.env 后按需修改）
# 也可不建文件，直接用环境变量 / 命令行参数。
#
# 默认流程是本机 -PackageOnly（只编译打包并打印后续命令）。
# 全自动上传需本机可交互输入密码，或已配置 SSH 免密：
#   .\infra\deploy\cloud-update.local.ps1 -UploadAndRemote

AI_NOVEL_CLOUD_HOST=220.160.32.37
AI_NOVEL_CLOUD_USER=root
AI_NOVEL_CLOUD_PATH=/opt/ai-novel
AI_NOVEL_CLOUD_SSH_PORT=22
